{
  "project": {
    "name": "iara-bot-reviewer",
    "description": "Code Reviewer BOT Agent",
    "tech_stack": [
      "Python"
    ]
  },
  "review": {
    "focus_areas": [
      "Logic",
      "Security",
      "Clean Code",
      "Error Handling",
      "Performance",
      "Testing"
    ],
    "ignore_patterns": [
      ".assets",
      "openspec"
    ],
    "max_diff_tokens": 12000
  },
  "ci": {
    "platform": "github",
    "review_mode": "inline"
  },
  "model": {
    "provider": "groq",
    "preferred": "llama-3.3-70b-versatile",
    "fallback_enabled": true
  },
  "language": "en"
}